node_modules/

# Local PHP/Composer runtimes. They are deployment artifacts, not source.
.runtime/
webman-backend/vendor/
runtime/

# Runtime data
data/
logs/
*.log
wikist-server.*.log

# Generated by /install.html for each deployment.
config/site.config.json

# Local wiki content and history.
content/pages/*
content/revisions/*
content/deleted/*
content/reviewed/*
!content/pages/.gitkeep
!content/revisions/.gitkeep
!content/deleted/.gitkeep
!content/reviewed/.gitkeep

# Upstream source caches, re-synced and reviewed locally.
plugins/vendor/

# Site-local public uploads such as custom icons.
public/uploads/*
!public/uploads/.gitkeep

# Local scratch artifacts.
.agents/
output/
tmp/
*.tmp
*.bak
Thumbs.db
.DS_Store
