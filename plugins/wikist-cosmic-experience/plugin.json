{
  "id": "cosmicExperience",
  "name": "Wikist 星际视觉体验",
  "type": "visual-extension",
  "version": "1.0.2",
  "source": "Wikist Core / Native Canvas",
  "license": "MIT",
  "description": "为首页和 Wikist Passport 提供可开关的科幻视觉层：知识核心连接开场、登录黑洞吸积盘和首页标题粒子聚合。",
  "syntax": [
    "后台 -> 插件管理 -> Wikist 星际视觉体验",
    "enabled: true",
    "intro: true",
    "authBlackHole: true",
    "titleParticles: true"
  ],
  "configKeys": ["enabled", "intensity", "intro", "introOnce", "authBlackHole", "titleParticles", "maxDpr"],
  "defaultConfig": {
    "enabled": true,
    "intensity": "balanced",
    "intro": true,
    "introOnce": true,
    "authBlackHole": true,
    "titleParticles": true,
    "maxDpr": 1.5
  },
  "entry": "clientModule",
  "clientModule": "cosmic.mjs"
}
