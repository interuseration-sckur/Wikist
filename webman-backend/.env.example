APP_ENV=production
APP_DEBUG=false
APP_NAME=Wikist
APP_TIMEZONE=Asia/Shanghai
APP_URL=https://wiki.example.com
WIKIST_PUBLIC_URL=https://wiki.example.com
APP_SECRET=replace-with-at-least-32-random-bytes

WEBMAN_HOST=0.0.0.0
WEBMAN_PORT=8899
WEBMAN_WORKERS=1
WEBMAN_USER=www-data
WEBMAN_GROUP=www-data

# Wikist owns one database. Point SQLite at the current Node database during
# the transition, or select MySQL for a new production installation.
WIKIST_DB_DRIVER=sqlite
WIKIST_DB_PROFILE=sqlite-single-host
WIKIST_DB_DATABASE=../data/wikist.sqlite
WIKIST_DB_HOST=127.0.0.1
WIKIST_DB_PORT=3306
WIKIST_DB_USERNAME=wikist
WIKIST_DB_PASSWORD=
WIKIST_DB_BUSY_TIMEOUT=10000
WIKIST_DB_SYNCHRONOUS=normal
MESSAGING_PRESENCE_TTL=40
MESSAGING_HEARTBEAT_INTERVAL=15
MESSAGING_PRESENCE_WRITE_INTERVAL=20
WIKIST_INSTALL_BOOTSTRAP_SECRET=
WIKIST_INSTALL_MODE_TTL_SECONDS=900
LEGACY_PROXY_REQUEST_MAX_BYTES=16777216
LEGACY_PROXY_RESPONSE_MAX_BYTES=16777216
LEGACY_PROXY_REQUEST_LARGE_MAX_BYTES=268435456
LEGACY_PROXY_RESPONSE_LARGE_MAX_BYTES=268435456
WIKIST_TRUSTED_CLIENT_PLUGINS=
PASSPORT_REHASH_ON_LOGIN=false

# Accept existing wikist_passport cookies while Webman and Node coexist.
WIKIST_LEGACY_BRIDGE=true
WIKIST_LEGACY_COOKIE=wikist_passport

# Optional, import-only source. Never used by normal requests.
PASSPORT_IMPORT_DB_DRIVER=mysql
PASSPORT_IMPORT_DB_HOST=127.0.0.1
PASSPORT_IMPORT_DB_PORT=3306
PASSPORT_IMPORT_DB_DATABASE=passport
PASSPORT_IMPORT_DB_USERNAME=passport
PASSPORT_IMPORT_DB_PASSWORD=

# Unported APIs can temporarily be forwarded to Node. Keep this internal.
LEGACY_NODE_PROXY=true
LEGACY_NODE_URL=http://127.0.0.1:8900
LEGACY_NODE_TOKEN=

SESSION_DRIVER=file
SESSION_COOKIE=wikist_session
SESSION_DOMAIN=
SESSION_SECURE=true
SESSION_SAME_SITE=Lax
SESSION_LIFETIME=604800

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

TRUSTED_ORIGINS=https://wiki.example.com
TRUSTED_PROXIES=127.0.0.1/32,::1/128
WIKIST_SITE_ID=
WIKIST_BACKUP_SIGNING_KEY=
WIKIST_REQUIRE_SIGNED_BACKUPS=false
WIKIST_RELEASE_SIGNING_KEY=
WIKIST_REQUIRE_SIGNED_RELEASE=false
WIKIST_ALLOW_UNVERIFIED_CDN=false
AUDIT_RETENTION_DAYS=180
WIKIST_MARKDOWN_MAX_CHARS=2097152
WIKIST_MARKDOWN_MAX_LINES=50000
WIKIST_MARKDOWN_MAX_INLINE_MARKERS=24000

# Unified Messaging. Webman owns data and authorization; Centrifugo only
# transports realtime events. Keep disabled until Centrifugo is configured.
MESSAGING_ENABLED=true
MESSAGING_ATTACHMENT_ROOT=../data/uploads/messaging
MESSAGING_ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_USER_QUOTA_BYTES=536870912
ATTACHMENT_PENDING_QUOTA_BYTES=67108864
ATTACHMENT_PENDING_COUNT_LIMIT=25
ATTACHMENT_PENDING_TTL_SECONDS=86400
SMTP_ALLOWED_PORTS=25,465,587,2525
SMTP_ALLOW_PRIVATE_HOSTS=false
MESSAGING_MESSAGE_MAX_CHARS=20000
MESSAGING_WITHDRAW_WINDOW=900
CENTRIFUGO_ENABLED=false
CENTRIFUGO_PUBLIC_URL=wss://wiki.example.com/connection/websocket
CENTRIFUGO_API_URL=http://127.0.0.1:8902/api
CENTRIFUGO_API_KEY=replace-with-a-random-api-key
CENTRIFUGO_TOKEN_HMAC_SECRET=replace-with-a-random-hmac-secret
CENTRIFUGO_TOKEN_TTL=300
CENTRIFUGO_SUBSCRIPTION_TTL=300

# Temporary compatibility gateway. It is off by default and is not used by
# unified messaging.
LEGACY_REALTIME_ENABLED=false
LEGACY_REALTIME_HOST=0.0.0.0
LEGACY_REALTIME_PORT=8897
